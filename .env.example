# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID. Оставьте пустым: после запуска бот пришлёт его в ответ на /start
TELEGRAM_OWNER_ID=

# Логин стримера из ссылки twitch.tv/<логин>
TWITCH_CHANNEL=

# OAuth-клиент Google типа «TVs and Limited Input devices»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключ шифрования токенов. Сгенерировать:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=

# Часовой пояс для дат в сообщениях и описаниях, например Europe/Moscow
TZ=UTC

# Необязательные настройки (показаны значения по умолчанию)
# YOUTUBE_PRIVACY=private
# YOUTUBE_LANGUAGE=ru
# MIN_SEGMENT_SEC=120
# UPLOAD_LIMIT_MBIT=250
# UPLOAD_CHUNK_MB=32
# DISK_RESERVE_GB=2
