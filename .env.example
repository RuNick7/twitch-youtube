# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID. Оставьте пустым: после запуска бот пришлёт его в ответ на /start
TELEGRAM_OWNER_ID=

# Логин первого стримера из ссылки twitch.tv/<логин>. Остальных добавляет команда бота /add.
# Смена логина здесь добавит новый канал, но не уберёт прежний: для этого есть /remove
TWITCH_CHANNEL=zakvielchannel
# Имя первого стримера в конце названия ролика — так, как его ищут зрители. Пусто — имя канала на Twitch.
# Бот запоминает имя в базе при первом запуске, и потом изменение здесь уже не действует: сменить — /name
STREAMER_NAME=Заквиель

# OAuth-клиент Google типа «TVs and Limited Input devices»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключ шифрования токенов. Сгенерировать:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=

# Часовой пояс для дат и времени в сообщениях и описаниях, например Europe/Moscow
TZ=UTC

# Необязательные настройки (показаны значения по умолчанию). Они действуют для всех стримеров.
# Публикацию, фильтры, нарезку, плейлисты, Shorts и YOUTUBE_LANGUAGE можно задать стримеру отдельно
# командой бота /set; слежение за каналами, ссылки на политику и скорость загрузки — только здесь

# Публикация: ролик без предупреждений становится публичным через PUBLISH_DELAY_MIN минут
# после обработки на YouTube. AUTO_PUBLISH=false — спрашивать про каждый ролик.
# PUBLISH_PRIVACY=unlisted — публиковать по ссылке, а не для всех
# AUTO_PUBLISH=true
# Не мешают автопубликации (после согласия с обновлённой политикой в боте): ограничение 18+ и блокировка
# не больше чем в AUTO_PUBLISH_MAX_BLOCKED странах; 0 — спрашивать при любой блокировке
# AUTO_PUBLISH_AGE_RESTRICTED=true
# AUTO_PUBLISH_MAX_BLOCKED=10
# PUBLISH_PRIVACY=public
# PUBLISH_DELAY_MIN=60
# MONITOR_DAYS=3

# Не загружать сегменты из SKIP_TITLE_CATEGORIES, если в названии стрима есть одно из слов
# SKIP_TITLE_KEYWORDS (так на стримах смотрят сериалы и фильмы). Категории из SKIP_CATEGORIES
# не загружаются никогда. Регистр и «ё» не важны, списки — через запятую
# SKIP_TITLE_KEYWORDS=во все тяжкие,звоните солу,сериал,серия,фильм,кино
# SKIP_TITLE_CATEGORIES=Just Chatting
# SKIP_CATEGORIES=Watch Party
# Загружать, но публиковать только после решения в Telegram
# WARN_CATEGORIES=Slots,Virtual Casino,Poker

# Как часто проверять канал (0 — не следить, только /process) и сколько ждать после конца стрима
# WATCH_INTERVAL_SEC=300
# WATCH_GRACE_MIN=10
# Как часто во время стрима запрашивать его название (0 — резать только по категориям)
# TITLE_POLL_SEC=60

# Нарезка: каждая смена категории или названия — граница. Куски короче MIN_SEGMENT_SEC
# приклеиваются к соседнему, короче SKIP_SHORTER_MIN минут не загружаются. JOIN_REPEATED — куски
# одного стрима с той же категорией и тем же названием склеиваются в один ролик, если между ними прошло не
# больше JOIN_MAX_GAP_MIN минут (короткий разговор посреди игры ролик не разрывает, другая долгая игра — разрывает).
# В NO_PART_CATEGORIES — категории без «Часть N» в названии ролика (у остальных номер сквозной по категории)
# MIN_SEGMENT_SEC=120
# SKIP_SHORTER_MIN=7
# JOIN_REPEATED=true
# JOIN_MAX_GAP_MIN=15
# NO_PART_CATEGORIES=Just Chatting,Minecraft

# Политика конфиденциальности и условия использования: бот показывает ссылки на них перед
# подключением канала. Для своей копии бота опубликуйте свои страницы (их же требует аудит YouTube API)
# PRIVACY_URL=https://runick7.github.io/twitch-youtube/privacy.html
# TERMS_URL=https://runick7.github.io/twitch-youtube/terms.html

# Плейлист на каждую категорию: опубликованный ролик добавляется в плейлист своей категории
# PLAYLISTS=true

# Shorts из клипов канала за последние 7 дней: от SHORTS_MIN_VIEWS просмотров на Twitch,
# не больше SHORTS_PER_DAY в сутки; клипы проверяются раз в SHORTS_CHECK_MIN минут
# SHORTS=true
# SHORTS_MIN_VIEWS=100
# SHORTS_PER_DAY=2
# SHORTS_CHECK_MIN=60
# Shorts публикуются раньше сегментов: через столько минут после обработки на YouTube
# SHORTS_PUBLISH_DELAY_MIN=30

# Нейросети. Когда заданы ключи, бот после нарезки стрима присылает в Telegram предложенные названия и главы
# для каждого ролика (режим наблюдения: на YouTube ничего не меняется). Бот сверяет оценку
# стоимости с дневным порогом AI_DAILY_LIMIT_USD. AI_OBSERVE=false — выключить.
# Нужны ключи API, подписки ChatGPT, Claude и Google не подходят. Расшифровка звука — openrouter.ai (на балансе
# не меньше $0.50, в настройках ключа задайте лимит трат), названия и таймкоды — console.anthropic.com (предоплата).
# GROQ_API_KEY (console.groq.com) не обязателен: это запасной сервис расшифровки, если OpenRouter не ответит
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# AI_OBSERVE=true
# AI_DAILY_LIMIT_USD=0.5

# YOUTUBE_LANGUAGE=ru
# UPLOAD_LIMIT_MBIT=200
# UPLOAD_CHUNK_MB=32
