# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID. Оставьте пустым: после запуска бот пришлёт его в ответ на /start
TELEGRAM_OWNER_ID=

# Логин стримера из ссылки twitch.tv/<логин>
TWITCH_CHANNEL=zakvielchannel

# OAuth-клиент Google типа «TVs and Limited Input devices»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключ шифрования токенов. Сгенерировать:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=

# Часовой пояс для дат и времени в сообщениях и описаниях, например Europe/Moscow
TZ=UTC

# Необязательные настройки (показаны значения по умолчанию)

# Публикация: ролик без предупреждений становится публичным через PUBLISH_DELAY_MIN минут
# после обработки на YouTube. AUTO_PUBLISH=false — спрашивать про каждый ролик.
# PUBLISH_PRIVACY=unlisted — публиковать по ссылке, а не для всех
# AUTO_PUBLISH=true
# PUBLISH_PRIVACY=public
# PUBLISH_DELAY_MIN=60
# MONITOR_DAYS=3

# Не загружать сегменты из SKIP_TITLE_CATEGORIES, если в названии стрима есть одно из слов
# SKIP_TITLE_KEYWORDS (так на стримах смотрят сериалы и фильмы). Категории из SKIP_CATEGORIES
# не загружаются никогда. Регистр и «ё» не важны, списки — через запятую
# SKIP_TITLE_KEYWORDS=во все тяжкие,звоните солу,сериал,серия,фильм,кино
# SKIP_TITLE_CATEGORIES=Just Chatting
# SKIP_CATEGORIES=Watch Party
# Загружать, но публиковать только после решения в Telegram
# WARN_CATEGORIES=Slots,Virtual Casino,Poker

# Как часто проверять канал (0 — не следить, только /process) и сколько ждать после конца стрима
# WATCH_INTERVAL_SEC=300
# WATCH_GRACE_MIN=10

# YOUTUBE_LANGUAGE=ru
# MIN_SEGMENT_SEC=120
# UPLOAD_LIMIT_MBIT=200
# UPLOAD_CHUNK_MB=32
